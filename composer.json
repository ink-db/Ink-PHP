{
  "name": "ink-php/connector",
  "description": "Asynchronous PHP connector for the Ink immutable database",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-sodium": "*",
    "ink/ext-blake3": "dev-stable",
    "pocketmine/errorhandler": "dev-master",
    "react/event-loop": "^1.5",
    "react/promise": "^3.2",
    "react/socket": "^1.17"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/ink-db/ext-blake3.git"
    }
  ],
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "inkphp\\": "src/inkphp/"
    }
  },
  "autoload-dev": {
    "psr-4": {"inkphp\\tests\\": "tests/"}
  },
  "scripts": {
    "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "cs:check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
    "stan": "phpstan analyse --configuration=phpstan.neon.dist",
    "test": "phpunit --configuration=phpunit.xml.dist --exclude-group integration",
    "test:integration": "phpunit --configuration=phpunit.xml.dist --group integration",
    "qa": ["@cs:check", "@stan", "@test"]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
